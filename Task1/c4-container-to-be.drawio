<mxfile host="app.diagrams.net">
  <diagram name="C4 Container To-Be" id="future20-c4-container-tobe">
    <mxGraphModel dx="1134" dy="782" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4100" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;" value="«Будущее 2.0» - целевая архитектура через год, диаграмма контейнеров C4" vertex="1">
          <mxGeometry height="30" width="1200" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;strokeColor=#B09000;fillColor=#FFF2CC;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;spacing=8;fontSize=11;" value="&lt;b&gt;Как целевая архитектура поддерживает бизнес-сценарии&lt;/b&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt;&amp;nbsp;быстрая подготовка отчётности: отчёты строятся по готовым витринам доменов в Lakehouse через Dremio&lt;br&gt;&lt;b&gt;2.&lt;/b&gt;&amp;nbsp;независимое развитие финтеха и ИИ: у каждого своя облачная среда, своя БД и своя логика, в DWH ничего не добавляем, а в Lakehouse своя зона&lt;br&gt;&lt;b&gt;3.&lt;/b&gt;&amp;nbsp;масштабирование на новые бизнесы: для нового направления создается своя среда и делается продукт данных по общему контракту платформы&lt;br&gt;&lt;b&gt;4.&lt;/b&gt;&amp;nbsp;уровень доступа и требования регулятора: медкарты и исследования не выходят из домена клиник, доступ к витрине организован через SSO и роли&lt;br&gt;&lt;b&gt;5.&lt;/b&gt;&amp;nbsp;отказоустойчивость: Object Storage мультизонный, настроены снапшоты Iceberg, а также бэкапы и реплика DWH" vertex="1">
          <mxGeometry height="170" width="760" x="4040" y="40" as="geometry" />
        </mxCell>
        <object placeholders="1" c4Name="Интеграционный слой" c4Type="SystemScopeBoundary" c4Application="Старая ESB и новый API шлюз" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;&lt;div style=&quot;text-align: right&quot;&gt;%c4Name%&lt;/div&gt;&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;text-align: right&quot;&gt;[%c4Application%]&lt;/div&gt;" id="b-esb">
